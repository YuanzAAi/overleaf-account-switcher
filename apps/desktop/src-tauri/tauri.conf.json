{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overleaf 账号控制台",
  "version": "0.1.0",
  "identifier": "local.overleaf-account-switcher",
  "build": {
    "frontendDist": "../frontend-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Overleaf 账号控制台",
        "width": 1040,
        "height": 720,
        "minWidth": 390,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "url": "index.html",
        "create": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
